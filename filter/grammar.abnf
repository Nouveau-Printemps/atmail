identifier = 1*ALPHA *( "_" / "-" / ALPHA / DIGIT )
string = DQUOTE *OCTET DQUOTE
number = ["-"] ( 1*DIGIT / *DIGIT "." 1*DIGIT )
literal = number / string

crlf = *WSP [CR] LF *WSP
sep = WSP / crlf

eval = identifier
eval =/ eval *("." identifier)
eval =/ eval *(":" identifier "(" *sep [expression *("," expression)] *sep ")")

operator_low = "=" / "!=" / ">" / "<" / ">=" / "<="
expression_low = ( literal / eval ) *(*WSP operator_low *sep expression)

operator_high = "or"
expression_high = expression_low *(1*WSP operator_high *sep expression)
expression = expression_high
expression =/ "(" *sep expression_high *sep ")"

block = "do" *(crlf statement) crlf "end"
filter = "filter" [1*WSP string] 1*WSP block

action = identifier *(1*WSP expression)

statement = filter / expression / action
